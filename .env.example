# Comment cap used when the request does not specify one.
MAX_COMMENTS_DEFAULT=500
# Hard ceiling; larger requests are clamped to this.
MAX_COMMENTS_CAP=2000
# Seconds allowed for metadata and for one comment-fetch attempt.
REQUEST_TIMEOUT=20
# Seconds allowed for the whole fetch step before it is abandoned.
FETCH_BUDGET=45
# Only groups at least this large are shown.
MIN_GROUP_SIZE=2

# Optional. Without a key the app uses deterministic template ideas.
# OpenAI:
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
#
# Gemini:
# LLM_API_KEY=AIza... or AQ....
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TOP_K=10
